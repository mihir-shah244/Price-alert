SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
# Gmail App Password, not your account password: https://myaccount.google.com/apppasswords
SMTP_PASSWORD=
ALERT_RECIPIENT_EMAIL=

CHECK_INTERVAL_HOURS=4
DATABASE_URL=sqlite:///data/app.db
# Local: leave Turso empty to use DATABASE_URL. Vercel: set both Turso vars.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Protects GET /api/cron/check-prices (Vercel Cron Authorization header)
CRON_SECRET=
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36
# false on Vercel (use Cron); true for local long-running uvicorn
SCHEDULER_ENABLED=true
